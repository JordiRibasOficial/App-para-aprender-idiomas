<?xml version="1.0" encoding="utf-8"?>
<!-- Brand splash: primary-blue background + centered conversation mark
     (reuses the adaptive-icon foreground already generated per density by
     flutter_launcher_icons, so there's nothing new to keep in sync). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
