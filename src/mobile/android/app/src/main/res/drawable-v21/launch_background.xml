<?xml version="1.0" encoding="utf-8"?>
<!-- Same branded splash as drawable/launch_background.xml — kept identical
     rather than falling back to ?android:colorBackground, so pre-M and
     API21+ devices see the same brand splash instead of two different
     looks. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
