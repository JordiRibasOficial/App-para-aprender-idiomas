# Copy to `.env` (gitignored) for local `supabase functions serve --env-file ./functions/.env`.
# In production, set these as Supabase project secrets instead:
#   supabase secrets set --env-file ./functions/.env
# Never commit a filled-in .env — see supabase/.gitignore.

# --- Android (Google Play) ---
# Full JSON key file contents (not a path) for a Google Cloud service
# account with "Service Account User" + Play Console API access granted
# under Play Console > Users and permissions > API access.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Android applicationId, e.g. com.example.app_para_aprender_idiomas
GOOGLE_PLAY_PACKAGE_NAME=

# --- iOS (App Store) ---
# App Store Connect > Users and Access > Integrations > In-App Purchase key.
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# PEM contents of the downloaded .p8 file (keep the BEGIN/END lines,
# replace literal newlines with \n if setting this via `secrets set`).
APPLE_PRIVATE_KEY=
# CFBundleIdentifier, e.g. com.example.appParaAprenderIdiomas
APPLE_BUNDLE_ID=
# "sandbox" while testing (TestFlight/Xcode), "production" once shipped.
APPLE_ENVIRONMENT=sandbox
